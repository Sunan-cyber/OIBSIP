# IMPORT required libraries
import speech_recognition as sr
import pyttsx3
import datetime
import webbrowser

# Initialise speech recognition and text-to-speech engines
recognizer = sr.Recognizer()
engine = pyttsx3.init()


# Converting the Text-to-speech
def speak(text):
    print("Assistant:", text)
    engine.say(text)
    engine.runAndWait()


# Listen to the user's voice and convert it into text
def listen():
    with sr.Microphone() as source:
        print("Listening...")
        recognizer.adjust_for_ambient_noise(source)

        try:
            audio = recognizer.listen(
                source,
                timeout=5,
                phrase_time_limit=8
            )

            command = recognizer.recognize_google(audio)

            print("You said:", command)
            return command.lower()

        except sr.UnknownValueError:
            speak("Sorry, I did not understand. Please repeat.")
            return ""

        except sr.RequestError:
            speak("Sorry, I cannot connect to the speech service.")
            return ""

        except sr.WaitTimeoutError:
            speak("I did not hear anything. Please try again.")
            return ""


# Main function that runs the voice assistant
def voice_assistant():
    speak("Hello!Greetings! I am your voice assistant. How can I help you?")

    while True:
        command = listen()

        if not command:
            continue

        # Hello
        if "hello" in command or "hi" in command:
            speak("Hello! Nice to meet you.")

        # Get current time and date
        elif "time" in command:
            current_time = datetime.datetime.now().strftime("%I:%M %p")
            speak(f"The current time is {current_time}")

        # Date
        elif "date" in command or "today" in command:
            current_date = datetime.datetime.now().strftime("%B %d, %Y")
            speak(f"Today's date is {current_date}")

        # Open a website in the default web browser
        elif "search" in command:
            topic = command.replace("search", "").strip()

            if topic:
                speak(f"Searching for {topic}")
                url = "https://www.google.com/search?q=" + topic.replace(" ", "+")
                webbrowser.open(url)
            else:
                speak("What would you like me to search for?")

        # Exit the assistant : Goodbye
        elif "goodbye" in command or "bye" in command or "exit" in command:
            speak("Goodbye! Have a nice day.")
            break

        # Response to any unkown command
        else:
            speak("I don't know that command yet. Please try again.")


# Start the assistant
voice_assistant()
