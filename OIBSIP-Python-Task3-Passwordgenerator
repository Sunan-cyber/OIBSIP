import string
import secrets


def generate_password(length, include_uppercase, include_lowercase,
                      include_numbers, include_special_characters):

    # Build character set
    chars = ""

    if include_uppercase:
        chars += string.ascii_uppercase

    if include_lowercase:
        chars += string.ascii_lowercase

    if include_numbers:
        chars += string.digits   # Numbers 0-9

    if include_special_characters:
        chars += string.punctuation

    # Make sure at least one character from each selected type is included
    password_chars = []

    if include_uppercase:
        password_chars.append(secrets.choice(string.ascii_uppercase))

    if include_lowercase:
        password_chars.append(secrets.choice(string.ascii_lowercase))

    if include_numbers:
        password_chars.append(secrets.choice(string.digits))  # 0-9

    if include_special_characters:
        password_chars.append(secrets.choice(string.punctuation))

    # Fill the remaining length
    while len(password_chars) < length:
        password_chars.append(secrets.choice(chars))

    # Shuffle the password
    secrets.SystemRandom().shuffle(password_chars)

    return "".join(password_chars)


if __name__ == "__main__":

    print("=== Password Generator ===")

    # Ask for password length
    while True:
        try:
            length = int(input("Enter desired password length (minimum 8): "))

            if length < 8:
                print("Error: Password length must be at least 8.")
            else:
                break

        except ValueError:
            print("Error: Please enter a valid number.")

            

    # Ask for character types
    while True:
        print("\nChoose character types:")
        print("Uppercase letters (A-Z)")
        print("Lowercase letters (a-z)")
        print("Numbers (0-9)")
        print("Symbols (!, @, #, $, etc.)")

        uppercase = input("Include uppercase letters? (y/n): ").lower()
        lowercase = input("Include lowercase letters? (y/n): ").lower()
        numbers = input("Include numbers 0-9? (y/n): ").lower()
        special = input("Include symbols? (y/n): ").lower()

        choices = [uppercase, lowercase, numbers, special]

        # Check for invalid input
        if any(choice not in ["y", "n"] for choice in choices):
            print("Error: Please enter only y or n.")
            continue

        # At least 2 types must be selected
        if choices.count("y") < 2:
            print("Error: Please select at least 2 character types.")
            continue

        break

    include_uppercase = uppercase == "y"
    include_lowercase = lowercase == "y"
    include_numbers = numbers == "y"
    include_special_characters = special == "y"

    # Generate password
    password = generate_password(
        length,
        include_uppercase,
        include_lowercase,
        include_numbers,
        include_special_characters
    )

    print("\nGenerated Password:", password)